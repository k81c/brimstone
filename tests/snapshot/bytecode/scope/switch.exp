}

[BytecodeFunction: capturesWithBreak] {
  Parameters: 0, Registers: 4
     0: LoadImmediate r2, 1
     3: PushLexicalScope c0
     5: LoadEmpty r3
     7: StoreToScope r3, 0, 0
    11: LoadImmediate r3, 1
    14: StrictEqual r3, r2, r3
    18: JumpTrue r3, 5 (.L0)
    21: Jump 18 (.L1)
  .L0:
    23: LoadImmediate r2, 1
    26: StoreToScope r2, 0, 0
    30: NewClosure r1, c1
    33: Mov r0, r1
    36: PopScope 
    37: Jump 3 (.L2)
  .L1:
    39: PopScope 
  .L2:
    40: LoadImmediate r2, 2
