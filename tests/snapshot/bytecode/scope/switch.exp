    4: [BytecodeFunction: captures]
    5: [String: captures]
    6: [BytecodeFunction: capturesWithBreak]
    7: [String: capturesWithBreak]
}

[BytecodeFunction: startScope] {
  Parameters: 0, Registers: 4
     0: LoadImmediate r2, 0
     3: LoadEmpty r0
     5: LoadEmpty r1
     7: LoadImmediate r3, 1
    10: StrictEqual r3, r2, r3
    14: JumpTrue r3, 25 (.L0)
    17: LoadImmediate r3, 2
    20: StrictEqual r3, r2, r3
    24: JumpTrue r3, 25 (.L1)
    27: LoadImmediate r3, 3
    30: StrictEqual r3, r2, r3
    34: JumpTrue r3, 17 (.L2)
    37: Jump 16 (.L3)
  .L0:
    39: CheckTdz r0, c0
    42: CheckTdz r1, c1
    45: Add r2, r0, r1
  .L1:
    49: LoadTrue r0
  .L2:
    51: LoadFalse r1
  .L3:
    53: LoadUndefined r2
    55: Ret r2
  Constant Table:
    0: [String: x]
    1: [String: y]
}

[BytecodeFunction: alwaysNeedTdzCheck] {
  Parameters: 0, Registers: 4
     0: LoadImmediate r2, 0
     3: LoadEmpty r1
     5: LoadImmediate r3, 1
     8: StrictEqual r3, r2, r3
    12: JumpTrue r3, 15 (.L0)
    15: LoadImmediate r3, 2
    18: StrictEqual r3, r2, r3
    22: JumpTrue r3, 10 (.L1)
    25: Jump 10 (.L2)
  .L0:
    27: LoadTrue r1
    29: CheckTdz r1, c0
  .L1:
    32: CheckTdz r1, c0
  .L2:
    35: LoadImmediate r2, 3
    38: LoadImmediate r3, 1
    41: StrictEqual r3, r2, r3
    45: JumpTrue r3, 5 (.L3)
    48: Jump 4 (.L4)
  .L3:
    50: LoadTrue r0
  .L4:
    52: LoadUndefined r2
    54: Ret r2
  Constant Table:
    0: [String: x]
}

[BytecodeFunction: captures] {
  Parameters: 0, Registers: 6
     0: LoadImmediate r4, 0
     3: PushLexicalScope c0
     5: LoadEmpty r5
     7: StoreToScope r5, 0, 0
    11: LoadImmediate r5, 1
    14: StrictEqual r5, r4, r5
    18: JumpTrue r5, 25 (.L0)
    21: LoadImmediate r5, 2
    24: StrictEqual r5, r4, r5
    28: JumpTrue r5, 22 (.L1)
    31: LoadImmediate r5, 3
    34: StrictEqual r5, r4, r5
    38: JumpTrue r5, 18 (.L2)
    41: Jump 37 (.L3)
  .L0:
    43: LoadImmediate r4, 1
    46: StoreToScope r4, 0, 0
  .L1:
    50: NewClosure r3, c1
    53: Mov r0, r3
  .L2:
    56: PushLexicalScope c2
    58: LoadEmpty r4
    60: StoreToScope r4, 0, 0
    64: NewClosure r2, c3
    67: Mov r1, r2
    70: LoadImmediate r4, 1
    73: StoreToScope r4, 0, 0
    77: PopScope 
  .L3:
    78: PopScope 
    79: LoadUndefined r4
    81: Ret r4
  Constant Table:
    0: [ScopeNames]
    1: [BytecodeFunction: inner1]
    2: [ScopeNames]
    3: [BytecodeFunction: inner2]
}

[BytecodeFunction: inner1] {
  Parameters: 0, Registers: 1
    0: LoadFromScope r0, 0, 0
    4: CheckTdz r0, c0
    7: Ret r0
  Constant Table:
